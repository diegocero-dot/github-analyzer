# ─────────────────────────────────────────────────────────────
# github-analyzer — environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values needed for your milestone.
# `.env` is git-ignored. NEVER commit real credentials.

# Required from M1+ (GitHub fetcher MVP). Personal access token, scope public_repo.
GITHUB_TOKEN=

# Required from M3+ (single-agent baseline). Anthropic API key.
ANTHROPIC_API_KEY=

# Required from M2+ (indexing). OpenAI API key for text-embedding-3-small.
OPENAI_API_KEY=

# Qdrant — local dev uses docker compose service (default). Prod uses Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
